{
  "name": "fhir-clinical-data-quality-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-local FHIR R4 data-quality lab with synthetic cases, traceable findings and value-free reports.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "license": "MIT"
}
